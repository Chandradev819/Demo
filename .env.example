# Keep existing Clerk keys in your local .env. Never commit real secrets.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Exact app origin, including the port locally. Use HTTPS in production.
APP_URL=http://localhost:4321
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
# A fixed-price product created in the SAME Dodo environment as the API key.
# Use a recurring product if you want a SaaS subscription.
DODO_PRO_PRODUCT_ID=

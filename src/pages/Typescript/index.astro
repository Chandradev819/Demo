---
import MainLayout from "../../layouts/Layout.astro";
---

<MainLayout title="TypeScript Demo | Astro Basics">
    <div class="container py-4">
        <div class="mb-4">
            <h2 class="fw-bold">Working with TypeScript in Astro</h2>
            <p class="text-muted">
                Learn how to use TypeScript for DOM manipulation, event
                handling, user input, and interactive components.
            </p>
        </div>

        <div class="row g-4">
            <!-- 1. Change Text -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">1. Change Text</h5>
                        <p id="message">
                            Click the button to change this message.
                        </p>
                        <button
                            type="button"
                            id="changeButton"
                            class="btn btn-primary"
                        >
                            Change Message
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. Change Style -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">2. Change CSS Style</h5>
                        <p id="colorText">
                            TypeScript can change HTML element styles.
                        </p>
                        <button
                            type="button"
                            id="colorButton"
                            class="btn btn-success"
                        >
                            Change Color
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3. Show / Hide -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">3. Show / Hide Element</h5>
                        <p id="secretMessage" class="alert alert-info">
                            This message can be hidden!
                        </p>
                        <button
                            type="button"
                            id="toggleButton"
                            class="btn btn-warning"
                        >
                            Hide Message
                        </button>
                    </div>
                </div>
            </div>

            <!-- 4. User Input -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">4. Read User Input</h5>
                        <label for="nameInput" class="form-label">
                            Your Name
                        </label>
                        <input
                            type="text"
                            id="nameInput"
                            class="form-control mb-3"
                            placeholder="Enter your name"
                        />
                        <button
                            type="button"
                            id="greetButton"
                            class="btn btn-info"
                        >
                            Say Hello
                        </button>
                        <p id="greeting" class="mt-3 mb-0"></p>
                    </div>
                </div>
            </div>

            <!-- 5. Counter -->
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <h5 class="card-title">5. TypeScript Counter</h5>
                        <h2 id="counter" class="display-5 fw-bold my-3">0</h2>

                        <div
                            class="d-flex justify-content-center gap-2 flex-wrap"
                        >
                            <button
                                type="button"
                                id="decrease"
                                class="btn btn-danger"
                            >
                                - Decrease
                            </button>
                            <button
                                type="button"
                                id="reset"
                                class="btn btn-secondary"
                            >
                                Reset
                            </button>
                            <button
                                type="button"
                                id="increase"
                                class="btn btn-success"
                            >
                                + Increase
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-light border mt-4">
            <strong>What you learned:</strong>
            TypeScript types, DOM manipulation, event handling, CSS classes, input
            values, functions, and variables.
        </div>
    </div>
</MainLayout>

<!-- Astro bundles and compiles the imported TypeScript -->
<script>
    import "./typescript-demo.ts";
</script>

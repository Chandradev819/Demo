---
import MainLayout from "../../layouts/Layout.astro";
---

<MainLayout title="Post Management | Astro Basics">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Post Management</h2>
            <p class="text-muted mb-0">
                CRUD operations using Astro, Bootstrap and REST API.
            </p>
        </div>

        <button id="btnAdd" class="btn btn-primary"> + Add Post </button>
    </div>

    <!-- Search -->
    <div class="card mb-3">
        <div class="card-body">
            <input
                type="text"
                id="search"
                class="form-control"
                placeholder="Search posts by title..."
            />
        </div>
    </div>

    <!-- Message -->
    <div id="message" class="alert d-none" role="alert"></div>

    <!-- Posts Table -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Body</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="postsTable">
                    <tr>
                        <td colspan="4" class="text-center p-4">
                            Loading posts...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="postModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="postForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitle">Add Post</h5>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="postId" />

                        <div class="mb-3">
                            <label for="postTitle" class="form-label">
                                Title
                            </label>
                            <input
                                type="text"
                                id="postTitle"
                                class="form-control"
                                required
                            />
                        </div>

                        <div class="mb-3">
                            <label for="postBody" class="form-label">
                                Description
                            </label>
                            <textarea
                                id="postBody"
                                class="form-control"
                                rows="4"
                                required></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal"
                        >
                            Cancel
                        </button>
                        <button
                            type="submit"
                            class="btn btn-primary"
                            id="btnSave"
                        >
                            Save Post
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</MainLayout>

<script>
    // @ts-expect-error Bootstrap's JavaScript package has no bundled declarations.
    import { Modal } from "bootstrap";

    interface Post {
        id: number;
        title: string;
        body: string;
        userId: number;
    }

    const apiUrl = "https://jsonplaceholder.typicode.com/posts";

    const table = document.querySelector(
        "#postsTable",
    ) as HTMLTableSectionElement;
    const search = document.querySelector("#search") as HTMLInputElement;
    const message = document.querySelector("#message") as HTMLElement;
    const form = document.querySelector("#postForm") as HTMLFormElement;
    const postId = document.querySelector("#postId") as HTMLInputElement;
    const postTitle = document.querySelector("#postTitle") as HTMLInputElement;
    const postBody = document.querySelector("#postBody") as HTMLTextAreaElement;
    const btnSave = document.querySelector("#btnSave") as HTMLButtonElement;

    const modalElement = document.querySelector("#postModal") as HTMLElement;
    const modal = new Modal(modalElement);

    let posts: Post[] = [];
    let nextId = 101;

    function showMessage(text: string, success = true) {
        message.textContent = text;
        message.className = `alert alert-${success ? "success" : "danger"}`;
    }

    function renderPosts() {
        const keyword = search.value.toLowerCase();

        const filtered = posts.filter((p) =>
            p.title.toLowerCase().includes(keyword),
        );

        table.replaceChildren();

        if (filtered.length === 0) {
            const row = table.insertRow();
            const cell = row.insertCell();
            cell.colSpan = 4;
            cell.className = "text-center p-4 text-muted";
            cell.textContent = "No posts found.";
            return;
        }

        filtered.forEach((post) => {
            const row = table.insertRow();

            row.insertCell().textContent = String(post.id);
            row.insertCell().textContent = post.title;

            const bodyCell = row.insertCell();
            bodyCell.textContent =
                post.body.substring(0, 80) +
                (post.body.length > 80 ? "..." : "");

            const actions = row.insertCell();
            actions.className = "text-end text-nowrap";

            const edit = document.createElement("button");
            edit.className = "btn btn-sm btn-outline-primary me-2";
            edit.textContent = "Edit";
            edit.addEventListener("click", () => editPost(post.id));

            const del = document.createElement("button");
            del.className = "btn btn-sm btn-outline-danger";
            del.textContent = "Delete";
            del.addEventListener("click", () => deletePost(post.id));

            actions.append(edit, del);
        });
    }

    // GET
    async function loadPosts() {
        try {
            const response = await fetch(apiUrl);

            if (!response.ok) {
                throw new Error("Failed to load posts.");
            }

            posts = (await response.json()).slice(0, 10);
            renderPosts();
        } catch (error) {
            showMessage("Unable to load posts.", false);
        }
    }

    // Open Add Modal
    document.querySelector("#btnAdd")?.addEventListener("click", () => {
        form.reset();
        postId.value = "";
        document.querySelector("#modalTitle")!.textContent = "Add Post";
        modal.show();
    });

    // Open Edit Modal
    function editPost(id: number) {
        const post = posts.find((p) => p.id === id);
        if (!post) return;

        postId.value = String(post.id);
        postTitle.value = post.title;
        postBody.value = post.body;

        document.querySelector("#modalTitle")!.textContent = "Edit Post";
        modal.show();
    }

    // POST / PUT
    form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const id = Number(postId.value);
        const isEdit = postId.value !== "";

        const data = {
            title: postTitle.value.trim(),
            body: postBody.value.trim(),
            userId: 1,
        };

        if (!data.title || !data.body) return;

        btnSave.disabled = true;

        try {
            const response = await fetch(isEdit ? `${apiUrl}/${id}` : apiUrl, {
                method: isEdit ? "PUT" : "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(isEdit ? { id, ...data } : data),
            });

            if (!response.ok) {
                throw new Error("Save failed.");
            }

            if (isEdit) {
                posts = posts.map((p) => (p.id === id ? { id, ...data } : p));
            } else {
                posts.unshift({ id: nextId++, ...data });
            }

            renderPosts();
            modal.hide();

            showMessage(
                isEdit
                    ? "Post updated successfully!"
                    : "Post created successfully!",
            );
        } catch (error) {
            showMessage("Unable to save post.", false);
        } finally {
            btnSave.disabled = false;
        }
    });

    // DELETE
    async function deletePost(id: number) {
        if (!confirm("Are you sure you want to delete this post?")) {
            return;
        }

        try {
            const response = await fetch(`${apiUrl}/${id}`, {
                method: "DELETE",
            });

            if (!response.ok) {
                throw new Error("Delete failed.");
            }

            posts = posts.filter((p) => p.id !== id);
            renderPosts();

            showMessage("Post deleted successfully!");
        } catch (error) {
            showMessage("Unable to delete post.", false);
        }
    }

    search.addEventListener("input", renderPosts);

    loadPosts();
</script>
